# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
AUDIT_HASH_SALT=replace-with-at-least-32-random-characters
RATE_LIMIT_HASH_SALT=replace-with-at-least-32-random-characters
MEMBER_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-secret

# Safety defaults: real personal data remains blocked until every launch gate passes.
NEXT_PUBLIC_DATA_MODE=synthetic
LAUNCH_GATES_COMPLETE=false

# Enable only for the approved manual PRC bank-transfer production campaign.
ENABLE_OFFICIAL_PAYMENT_HANDOFF=false

# Optional infrastructure
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
