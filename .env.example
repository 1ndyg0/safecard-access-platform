# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENVIRONMENT=development

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
AUDIT_HASH_SALT=replace-with-at-least-32-random-characters
RATE_LIMIT_HASH_SALT=replace-with-at-least-32-random-characters
MEMBER_SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-random-secret
PAYMENT_PROOFS_BUCKET=payment-proofs

# Safety defaults: real personal data remains blocked until every launch gate passes.
NEXT_PUBLIC_DATA_MODE=synthetic
LAUNCH_GATES_COMPLETE=false

# Cost/provider-dependent features are parked by default.
ENABLE_OFFICIAL_PAYMENT_HANDOFF=false

# Required only in controlled live mode. Pin the reviewed records explicitly.
APPROVED_CAMPAIGN_ID=
APPROVED_CONTENT_VERSION=

# One-time bootstrap command inputs. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
CONTROLLED_PILOT_CONFIG_PATH=config/controlled-pilot.example.json
CONFIRM_CONTROLLED_PILOT_BOOTSTRAP=

# Optional infrastructure
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WEBHOOK_SIGNING_SECRET=
